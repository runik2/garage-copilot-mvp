# Вариант 1 — без Docker: PostgreSQL (PGlite) внутри Node
DB_MODE=local
PGLITE_DIR=./data/pgdata
# Вариант 2 — обычный PostgreSQL (Docker или установленный локально):
# DATABASE_URL=postgres://garage:garage@localhost:5432/garage
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=owner@local
ADMIN_PASSWORD=change-me-now
PORT=3001
UPLOAD_DIR=./data/uploads
